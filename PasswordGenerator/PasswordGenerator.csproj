<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>PasswordGenerator</PackageId>
    <Description>A cryptographically secure password generator library.</Description>
    <Authors>PasswordGenerator Contributors</Authors>
    <PackageTags>password;generator;security;cryptography</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackCoreAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PasswordGenerator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Interfaces\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <None Remove="Interfaces\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PasswordGenerator.Core\PasswordGenerator.Core.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackCoreAssembly">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)PasswordGenerator.Core.dll" />
    </ItemGroup>
  </Target>

</Project>
